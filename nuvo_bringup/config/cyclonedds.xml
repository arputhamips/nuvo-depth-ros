<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <!-- Fit an ordinary 1500-byte Ethernet MTU, including UDP/IP headers.
           DDS fragments large images/clouds without relying on IP reassembly. -->
      <MaxMessageSize>1400B</MaxMessageSize>
      <FragmentSize>1200B</FragmentSize>
    </General>
    <Internal>
      <!-- Absorb full image/cloud bursts; the host helper permits this request.
           Keep startup portable when a subscriber host has a smaller limit.
           Consumers should load this profile and prepare their own host limit. -->
      <SocketReceiveBufferSize min="default" max="8MiB"/>
    </Internal>
  </Domain>
</CycloneDDS>
